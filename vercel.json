{
  "crons": [
    { "path": "/api/admin/gelato-sync",                 "schedule": "0 0 * * *"  },
    { "path": "/api/cron/morning-report?type=gelato-discovery", "schedule": "0 2 * * *"  },
    { "path": "/api/cron/morning-report?type=agents",   "schedule": "0 4 * * *"  },
    { "path": "/api/cron/morning-report",               "schedule": "0 5 * * *"  },
    { "path": "/api/cron/review-requests",              "schedule": "0 8 * * *"  },
    { "path": "/api/cron/morning-report?type=auto-run",  "schedule": "0 6 * * *"  },
    { "path": "/api/cron/morning-report?type=content",  "schedule": "0 10 * * *" },
    { "path": "/api/cron/morning-report?type=auto-run",  "schedule": "0 12 * * *" },
    { "path": "/api/cron/morning-report?type=content",  "schedule": "0 16 * * *" },
    { "path": "/api/cron/morning-report?type=security", "schedule": "0 3 * * *"  },
    { "path": "/api/cron/morning-report?type=weekly-marketing-plan", "schedule": "0 4 * * 0"  }
  ],
  "rewrites": [
    { "source": "/dub-console", "destination": "/admin.html"   },
    { "source": "/terms",   "destination": "/terms.html"   },
    { "source": "/returns", "destination": "/returns.html" },
    { "source": "/us", "destination": "/index.html" },
    { "source": "/us/:path*", "destination": "/index.html" },
    { "source": "/ig-content/:path*", "destination": "https://ntzwvqtpdmvvavbhuyeb.supabase.co/functions/v1/agents?type=serve-image&f=:path*" },
    { "source": "/shopping-feed.xml", "destination": "https://ntzwvqtpdmvvavbhuyeb.supabase.co/functions/v1/shopping-feed" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.paypal.com https://js.paypal.com https://*.paypal.com https://cdn.jsdelivr.net https://connect.facebook.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.paypal.com https://js.paypal.com https://*.paypal.com; connect-src 'self' https://api.paypal.com https://*.paypal.com https://*.supabase.co https://www.facebook.com https://connect.facebook.net https://www.google-analytics.com https://*.analytics.google.com;" }
      ]
    }
  ]
}
